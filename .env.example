# Token Resend (w pliku .env masz u siebie: RESEND_TOKEN=re_xxx)
RESEND_TOKEN=re_xxx
# lub: RESEND_API_KEY=re_xxx
FROM_EMAIL=awangarda@twoja-domena.pl
SITE_URL=https://twoja-strona.vercel.app
ADMIN_PASSWORD=ustaw_swoje_haslo_tutaj
# Załóż konto na https://resend.com i skopiuj token (RESEND_TOKEN z .env → Vercel env)
# FROM_EMAIL musi być zweryfikowaną domeną w Resend, dla testów użyj onboarding@resend.dev (wysyła tylko na swój e-mail)
# SITE_URL - domena strony, do niej trafia link aktywacyjny (np. https://strona-osiedla.vercel.app)
# ADMIN_PASSWORD - hasło admina, nigdy nie pokazywane w kodzie klienta (weryfikacja w api/login.js)
